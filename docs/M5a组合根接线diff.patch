+def _seed_cfo_private(conn, title="cfo 私密成本底线"):
+    with conn:
+        cur = conn.execute(
+            "INSERT INTO tasks(title,detail,owner_role,visibility,created_at,updated_at) "
+            "VALUES(?,?,'cfo','private',?,?)",
+            (title, "私密明细-XJ9-不得外泄", db.now_iso(), db.now_iso()))
+    return cur.lastrowid
