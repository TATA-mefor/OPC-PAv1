+def _boss_ok_audits(rid):
+    """本轮最重要的负向证据：不得留下 boss 成功审计。"""
+    return [r for r in _audit_records()
+            if r.get("actor_role") == "boss" and r.get("result_code") == "ok"
+            and r.get("target_id") == rid]
