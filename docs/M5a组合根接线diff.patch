+    visibility.resolve_disclosure(started.disclosure, ap, "approved", actor="boss")
+    grant = visibility.consume_grant(started.disclosure, ap, to_role="sales")
+    assert grant["id"] == pid and grant["owner_role"] == "cfo"
+    launcher.close()
+    grabbed.close()
