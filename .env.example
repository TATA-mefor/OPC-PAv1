# PERSONAL AGENT 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 排除）
# 缺失 Key 时应用以 L1 降级模式启动（关键词路由 + 工具直调），不崩溃。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# 月度 token 预算闸（超限降级，PRD §17）
MONTHLY_TOKEN_BUDGET=2000000
REMINDER_SCAN_INTERVAL_S=30
VAULT_SCAN_INTERVAL_S=30
# 可选：指向已有 Obsidian 仓库（缺省 OPC-PAv1/vault/）
VAULT_PATH=
